  "my_shift_guide": {
    "title": "班次页面使用方法",
    "description": "在此页面可以查看分配给自己的已确认班次，并提交换班申请。",
    "view_shifts": {
      "title": "查看已确认班次",
      "body": "以月历或周列表显示分配给当前登录用户的已确认班次。没有班次的日期会保持空白。",
      "steps": {
        "step1": "打开“/my/shift”页面",
        "step2": "页面会自动加载已确认班次，并显示在月历或列表中",
        "step3": "没有班次时会显示“暂无班次”"
      }
    },
    "switch_view": {
      "title": "切换显示方式",
      "body": "可以在月历（便于把握整体）和周列表（便于查看详情）两种视图之间切换。使用箭头按钮可前往上一个或下一个月、周。",
      "steps": {
        "step1": "使用屏幕顶部的“月视图”“周视图”按钮切换显示形式",
        "step2": "使用 ◀ ▶ 按钮前往上个月/下个月（或上一周/下一周）",
        "step3": "点击“今天”按钮即可回到包含今天的月/周"
      }
    },
    "filter_team": {
      "title": "按团队筛选",
      "body": "如果您属于多个团队，可以只显示特定团队的班次。选择“全部”按钮即可显示所有团队的班次。",
      "steps": {
        "step1": "点击屏幕顶部“团队:”栏中的“全部”或团队名称按钮",
        "step2": "只会显示所选团队的班次",
        "step3": "再次点击“全部”即可取消筛选"
      }
    },
    "view_detail": {
      "title": "查看班次详情",
      "body": "点击具体日期，即可查看该班次的团队名称、岗位、时间、排班名称等详情。",
      "steps": {
        "step1": "【月视图】点击日期格，屏幕右侧会打开详情面板",
        "step2": "【周视图】点击日期卡片的标题，卡片会展开并显示班次列表",
        "step3": "在月视图中再次点击同一日期，详情面板就会关闭"
      }
    },
    "swap_request": {
      "title": "提交换班申请",
      "body": "如果想与其他成员交换已确认的班次，可以通过三种方式发送申请。发送后，班次列表会自动更新。",
      "steps": {
        "step1": "点击班次详情中的“创建换班申请”按钮",
        "step2": "选择发送方式：“指定成员”（至少选择 1 人）／“按班次时段批量发送”（同一天白班或夜班的全部人员）／“向所有人公开”（任何人都可以报名）",
        "step3": "如有需要，请填写理由（可选）",
        "step4": "点击“提交”按钮发送"
      },
      "note": "提交后，已确认班次列表会自动更新。发送期间按钮将处于禁用状态，请等待完成。"
    }
  },
  "shift_guide": {
    "title": "班次管理使用方法",
    "description": "在班次管理中，可以创建并发布团队的排班表，收集并协调成员的班次意愿。",
    "overview": {
      "title": "查看排班表列表",
      "body": "在此页面管理团队的排班表列表。通过状态标记可一目了然地了解进度。",
      "steps": {
        "step1": "按状态筛选（草稿、收集中、协调中、已发布等）",
        "step2": "通过每张卡片上的提交率进度条，查看成员的意愿提交情况",
        "step3": "点击卡片即可进入详情页面"
      }
    },
    "create": {
      "title": "创建新的排班表",
      "body": "团队管理员可以新建排班表。先设置标题和周期即可开始。",
      "steps": {
        "step1": "点击右上角的“新建”按钮",
        "step2": "输入标题、开始日期和结束日期（必填）",
        "step3": "根据需要输入意愿提交截止时间和备注",
        "step4": "点击“创建”按钮确认（以“草稿”状态创建）"
      }
    },
    "status": {
      "title": "推进状态以确定班次",
