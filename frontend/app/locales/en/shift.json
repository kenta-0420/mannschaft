  "shift_guide": {
    "title": "シフト管理の使い方",
    "description": "シフト管理では、チームのシフトスケジュールを作成・公開し、メンバーの希望を収集して調整できます。",
    "overview": {
      "title": "シフトスケジュール一覧を確認する",
      "body": "このページでは、チームのシフトスケジュール一覧を管理します。ステータスバッジで進捗が一目で分かります。",
      "steps": {
        "step1": "ステータスフィルタ（下書き・収集中・調整中・公開済みなど）で絞り込む",
        "step2": "各カードの提出率バーでメンバーの希望提出状況を確認する",
        "step3": "カードをクリックして詳細ページへ移動する"
      }
    },
    "create": {
      "title": "新しいシフトスケジュールを作成する",
      "body": "チームの管理者がシフトスケジュールを新規作成できます。タイトルと期間を設定してスタートしましょう。",
      "steps": {
        "step1": "右上の「新規作成」ボタンをクリックする",
        "step2": "タイトル・開始日・終了日を入力する（必須）",
        "step3": "希望締切・メモを必要に応じて入力する",
        "step4": "「作成」ボタンで確定する（ステータス：下書きで作成）"
      }
    },
    "status": {
      "title": "ステータスを進めてシフトを確定させる",
      "body": "シフトは5段階のステータスで管理されます。詳細ページのステッパーで現在のフェーズを確認し、順番に進めましょう。",
      "steps": {
        "step1": "「下書き」：スロットや制約を設定する準備段階",
        "step2": "「収集中」：メンバーにシフト希望の提出を依頼する",
        "step3": "「調整中」：希望を元にシフトを調整・作成する",
        "step4": "「公開済み」：確定シフトをメンバーに公開する",
        "step5": "「完了」：終了したシフトをアーカイブする"
      }
    },
    "requests": {
      "title": "メンバーのシフト希望を収集・確認する",
      "body": "「収集中」ステータスになるとメンバーが希望を提出できます。詳細ページの「希望一覧」タブで全員の状況をマトリクスで確認できます。",
      "steps": {
        "step1": "詳細ページの「希望一覧」タブをクリックする",
        "step2": "サマリーカードで提出率・未提出人数を確認する",
        "step3": "マトリクス表で各メンバーの日付ごとの希望強度を確認する",
        "step4": "「出勤希望・指定なし・出れなくはない・できれば休み・絶対休み」の5段階で表示される"
      }
    },
    "slots": {
      "title": "スロットと勤務制約を設定する",
      "body": "シフトの時間帯（スロット）を登録し、チーム・メンバー別の勤務制約を設定します。",
      "steps": {
        "step1": "「編集」タブでスロット（日付・開始〜終了時刻・ポジション・必要人数）を作成する",
        "step2": "「一括作成」ボタンで日付範囲・曜日指定による複数スロットの一括登録も可能",
        "step3": "「制約」タブでチームデフォルトの勤務制約（月最大時間・連続勤務日数など）を設定する",
        "step4": "特定メンバーには「メンバー別の例外設定」で個別制約を上書き設定できる"
      }
    }
  }
}
