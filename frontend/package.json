{
  "name": "mannschaft-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:prune": "eslint . --prune-suppressions",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "generate:types": "npx openapi-typescript ../docs/openapi.json -o app/types/generated/index.ts"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^9.5.3",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.4",
    "@primevue/themes": "^4.5.4",
    "@stomp/stompjs": "^7.3.0",
    "@stripe/stripe-js": "^9.7.0",
    "@types/dompurify": "^3.0.5",
    "@vee-validate/zod": "^4.15.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/nuxt": "^14.2.1",
    "@zxing/browser": "^0.1.5",
    "bwip-js": "^4.10.1",
    "chart.js": "^4.5.1",
    "date-holidays": "^3.27.0",
    "dayjs": "^1.11.20",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.9",
    "frappe-gantt": "^1.2.2",
    "jsbarcode": "^3.12.3",
    "marked": "^17.0.5",
    "nosleep.js": "^0.12.0",
    "nuxt": "3.21.8",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "qrcode": "^1.5.4",
    "tailwindcss-primeui": "^0.6.1",
    "vee-validate": "^4.15.1",
    "vue": "latest",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vuedraggable": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.0",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.0",
    "@types/qrcode": "^1.5.6",
    "@vue/test-utils": "^2.4.6",
    "cheerio": "1.0.0-rc.12",
    "dotenv": "^17.4.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nuxt-security": "^1.4.3",
    "openapi-typescript": "^7.13.0",
    "otplib": "^13.4.0",
    "prettier": "^3.8.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.0",
    "vue-tsc": "3.3.7"
  },
  "overrides": {
    "cac": "^6.7.14",
    "commander": "^13.1.0",
    "esbuild": "^0.28.1",
    "h3": "^1.15.11",
    "crossws": "^0.4.5",
    "simple-git": "^3.36.0",
    "sharp": "^0.35.3",
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.0"
    }
  }
}
