# =============================================================================
# prod.tfvars の記入例
# =============================================================================
# 実ファイルは `prod.tfvars` という名前でこのディレクトリに置く（gitignore 済み）。
# ローカル実行: terraform plan -var-file=prod.tfvars
# CI 実行: GitHub variables（INFRA_DOMAIN_NAME 等）が TF_VAR_ 環境変数として注入される
#          ため、CI に prod.tfvars は不要。
#
# 注意: 秘密（API トークン・パスワード類）はこのファイルにも書かない。
#       CLOUDFLARE_API_TOKEN は環境変数、DB パスワードは Secrets Manager 自動管理。

# --- 必須（実値の例: 本番ドメインは mannschaft.app / 各 ID は Cloudflare ダッシュボードの
#     ゾーン概要ページ右サイドバーに表示される。いずれも識別子であり秘密ではない）---
domain_name           = "mannschaft.app"
cloudflare_account_id = "84f8542dfb6c498c508de13c0a973766"
cloudflare_zone_id    = "68957e39ff0a2bc8d42cbdcd972a3466"

# --- 任意（既定値あり。負荷が増えたらここで上げる）---
# db_instance_class = "db.t4g.micro"
# cache_node_type   = "cache.t4g.micro"
# task_cpu          = 512
# task_memory       = 1024
# vpc_cidr          = "10.0.0.0/16"

# --- cloudflared サイドカーのイメージ（既定は variables.tf の固定タグ）---
# 更新時は Docker Hub cloudflare/cloudflared の linux/arm64 対応の安定タグを確認して指定する
# cloudflared_image = "cloudflare/cloudflared:2026.7.1"

# --- 非秘密 env の追加・上書き（標準セットは envs/prod/main.tf の locals 参照）---
# app_env_extra = {
#   SPRING_PROFILES_ACTIVE = "prod"
# }
# pages_env_extra = {}

# --- WebSocket 外部ブローカー化（Valkey Pub/Sub relay）§1.3・§8.6 ---
# 既定 false。段階 1（desired_count=1 のまま relay ON で検証）着手時に true へ切替える。
# 適用前提: ElastiCache 転送時暗号化（transit_encryption_enabled）が有効化済みであること
# （本 apply では data module 側で常時 true・別変数化なし）。
# websocket_relay_enabled = true
