<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Virtual Threads (Java 21) + SLF4JBridgeHandler の組み合わせで発生する
        NoClassDefFoundError: ThrowableProxy を防ぐため、JUL の全ハンドラーをリセットする。
        これにより Tomcat の JUL エラーが SLF4JBridgeHandler を経由しなくなる。
        参照: https://logback.qos.ch/manual/configuration.html#LevelChangePropagator
    -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>

    <springProfile name="local,default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="DEBUG">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="test">
        <appender name="CONSOLE_TEST" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE_TEST" />
        </root>
    </springProfile>

    <!-- ci プロファイル（GitHub Actions）: アペンダーがないと全ログが無音になるため明示定義 -->
    <springProfile name="ci">
        <appender name="CONSOLE_CI" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_CI" />
        </root>
    </springProfile>

    <!--
        openapi-gen プロファイル（./gradlew generateOpenApiDocs のフォーク先）:
        ci と同じ理由でアペンダーを明示定義する。これが無いと root にアペンダーが1つも付かず、
        起動が失敗しても<b>一行も出ないまま exit 1</b> になる。springdoc プラグイン側は
        「http://localhost:8082/v3/api-docs へ 1800 秒つないだが応答しない」としか言えないため、
        原因（起動失敗か、単に遅いのか）が切り分け不能になる。実際に PR6a でこの穴により
        openapi.json の再生成が二度空振りした。
    -->
    <springProfile name="openapi-gen">
        <appender name="CONSOLE_OPENAPI_GEN" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_OPENAPI_GEN" />
        </root>
    </springProfile>
</configuration>
