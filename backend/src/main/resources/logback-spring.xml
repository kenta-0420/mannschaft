<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
        Virtual Threads (Java 21) + SLF4JBridgeHandler の組み合わせで発生する
        NoClassDefFoundError: ThrowableProxy を防ぐため、JUL の全ハンドラーをリセットする。
        これにより Tomcat の JUL エラーが SLF4JBridgeHandler を経由しなくなる。
        参照: https://logback.qos.ch/manual/configuration.html#LevelChangePropagator
    -->
    <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
        <resetJUL>true</resetJUL>
    </contextListener>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>userId</includeMdcKeyName>
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>

    <springProfile name="local,default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="DEBUG">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

    <springProfile name="test">
        <appender name="CONSOLE_TEST" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="WARN">
            <appender-ref ref="CONSOLE_TEST" />
        </root>
    </springProfile>

    <!-- ci プロファイル（GitHub Actions）: アペンダーがないと全ログが無音になるため明示定義 -->
    <springProfile name="ci">
        <appender name="CONSOLE_CI" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_CI" />
        </root>
    </springProfile>

    <!--
        フォールバック（上記のどのプロファイルにも当てはまらない場合）

        logback は root に appender が一つも紐付いていないと、そのアプリケーションのログを
        **一切出力しない**（エラーもスタックトレースも消える）。
        上の springProfile ブロックは prod / local / default / test / ci しか列挙していないため、
        新しいプロファイル（openapi-gen など）を足すと、そのプロファイルでの起動は完全な無音になり、
        「起動しないが理由が分からない」という診断不能状態に陥る。
        実際に openapi-gen プロファイル（generateOpenApiDocs）がこの穴に落ち、
        1800 秒タイムアウトするだけで原因ログが一切残らなかった（CMP-260912-1526）。

        そこで、列挙済みプロファイル以外すべてにマッチする否定式のブロックを置き、
        どのプロファイルで起動してもコンソールにログが出ることを構造的に保証する。
        プロファイルを新設したときに、ここを直し忘れても無音にはならない。
    -->
    <springProfile name="!prod &amp; !local &amp; !default &amp; !test &amp; !ci">
        <appender name="CONSOLE_FALLBACK" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_FALLBACK" />
        </root>
    </springProfile>
</configuration>
